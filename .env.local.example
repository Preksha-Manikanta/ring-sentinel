# ---------------------------------------------------------------------------
# Ring Sentinel — LOCAL demo overrides. Copy to `.env.local` (git-ignored) to
# point the frontend at a FastAPI backend on your own machine.
#
#   cp .env.local.example .env.local
#
# Vite loads `.env.local` after `.env`, so this overrides committed defaults for
# your machine only. VITE_* vars are PUBLIC to the browser — never put secrets
# (e.g. ANTHROPIC_API_KEY) here.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/events

# For a hosted judge demo, point at the deployed backend instead (HTTPS + WSS):
# VITE_API_BASE_URL=https://YOUR_BACKEND_HOST
# VITE_WS_URL=wss://YOUR_BACKEND_HOST/events
